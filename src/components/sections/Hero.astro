---
import AboutIcon from "../../assets/imagenes/myavatar.png";
---

<section
  id="about"
  class="flex min-h-[calc(100svh-4rem)] items-center px-6 py-12 lg:px-16 border-b border-white/10"
>
  <div
    class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-16 lg:grid-cols-2"
  >
    <!-- Información -->
    <div class="flex flex-col gap-6">
      <span
        class="w-fit border border-blue-400/20 bg-blue-400/5 px-4 py-2 text-sm uppercase tracking-[.2em] text-[#59C2FF]"
      >
        Acerca de mí
      </span>

      <h1
        class="font-bold leading-[1.1] text-stone-200 text-[clamp(2.2rem,5vw,3.8rem)]"
      >
        Richard Aaron
        <br />
        <span class="text-[#47AFAA]"> Ponce Villarroel </span>
      </h1>

      <h2 class="font-bold text-stone-300 text-[clamp(1.2rem,2vw,2rem)]">
        FullStack Junior Developer / Diseñador UI/UX
      </h2>

      <p
        class="max-w-[65ch] leading-relaxed text-stone-300 text-[clamp(.95rem,1vw,1.1rem)]"
      >
        FullStack Developer enfocado en crear aplicaciones modernas, interfaces
        responsivas y soluciones escalables combinando diseño UI/UX, frontend
        interactivo y tecnologías backend utilizando React, Astro, TailwindCSS y
        otras herramientas modernas.
      </p>

      <div class="flex flex-wrap gap-4">
        <button
          type="button"
          id="openModal"
          class="cursor-pointer px-8 py-4 group relative flex h-12 items-center justify-center overflow-hidden border border-[#59C2FF] text-xs uppercase tracking-[0.2em] text-[#59C2FF] transition-colors duration-500 ease-in-out hover:text-[#201F1F]"
        >
          <span class="relative z-10">Ver archivo</span>

          <span
            class="absolute inset-y-0 right-0 w-0 bg-[#59C2FF] transition-all duration-500 ease-in-out group-hover:left-0 group-hover:w-full"
          ></span>
        </button>

        <a
          href="/docs/CV_RichardAaronPonceVillarroel.docx"
          download="CV_RichardAaronPonceVillarroel.docx"
          class="px-8 py-4 group relative flex h-12 items-center justify-center overflow-hidden border border-[#59C2FF] text-xs uppercase tracking-[0.2em] text-[#59C2FF] transition-colors duration-500 ease-in-out hover:text-[#201F1F]"
        >
          <span class="relative z-10">Descargar CV</span>

          <span
            class="absolute inset-y-0 right-0 w-0 bg-[#59C2FF] transition-all duration-500 ease-in-out group-hover:left-0 group-hover:w-full"
          ></span>
        </a>
      </div>
    </div>

    <!-- Imagen -->
    <div class="flex justify-center lg:justify-end">
      <div
        class="relative aspect-square w-[clamp(280px,35vw,520px)] overflow-hidden border-10 border-stone-900 bg-stone-900 shadow-[0_0_30px_rgba(52,229,7,.15)]"
      >
        <img
          src={AboutIcon.src}
          alt="Richard Aaron"
          class="h-full w-full object-cover opacity-90 mix-blend-screen"
        />

        <div
          class="absolute bottom-[4%] left-[4%] border border-[#47AFAA] bg-stone-950/80 px-3 py-2"
        >
          <span class="text-[clamp(8px,.7vw,11px)] text-[#47AFAA]">
            USER_ID: 75375690
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
