---
import { experience } from "../../data/experience.ts";
---

<section id="experience" class="border-b border-white/10 px-6 py-16 lg:px-16">
  <div class="mx-auto flex max-w-7xl flex-col gap-10">
    <!-- Título -->
    <span
      class="w-fit border border-[#59C2FF]/20 bg-[#59C2FF]/5 px-4 py-2 text-sm font-bold uppercase tracking-widest text-[#59C2FF]"
    >
      Experiencia
    </span>

    <!-- Descripción -->
    <p class="leading-relaxed text-[#BBCCB0] text-[clamp(.95rem,1vw,1.1rem)]">
      Experiencia en el desarrollo de proyectos Frontend y Full Stack, creando
      interfaces modernas, responsivas y funcionales, con enfoque en e-commerce
      y soluciones digitales orientadas a una buena experiencia de usuario.
    </p>

    <!-- Card -->
    <div
      class="flex flex-col gap-8 rounded-sm border border-[#59C2FF]/30 bg-[#1C1B1B] p-5 backdrop-blur-[6px]"
    >
      <!-- Header -->
      <header
        class="flex items-center justify-between border-b border-[#59C2FF]/20 pb-4"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-[#59C2FF]">
          expe_desarrollada.LOG
        </span>

        <span class="text-sm text-[#D9D9D9] opacity-50"> V: 1.1 </span>
      </header>

      <!-- Timeline -->
      <div class="flex flex-col gap-16 mb-8">
        {
          experience.map((data) => (
            <article class="relative flex flex-col gap-5 border-l border-[#59C2FF]/30 pl-8">
              <span class="absolute -left-1.25 top-1 h-2 w-2 rounded-full bg-[#59C2FF]/80 shadow-[0_0_8px_rgba(89,194,255,1)]" />
              <div class="flex flex-wrap items-start justify-between gap-4">
                <h3 class="text-xl font-bold text-[#D9D9D9]">{data.title}</h3>

                <span class="text-xs text-[#D9D9D9]">{data.date}</span>
              </div>
              <p class="text-xs uppercase font-bold text-[#C8C8B0]">
                Empresa: {data.company}
              </p>
              <p class="text-base leading-6 text-[#BBCCB0]">
                {data.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {data.technologies.map((tech: any) => (
                  <span
                    class={`${tech.style} cursor-default border rounded-xs transition-all duration-300  px-6 py-2 text-[12px]`}
                  >
                    {tech.name}
                  </span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
