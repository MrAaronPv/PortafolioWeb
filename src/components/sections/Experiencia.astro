---
import { experience } from "../../data/experience.ts";
---

<section id="experience" class="border-b border-white/10 px-6 py-16 lg:px-16">
  <div class="mx-auto flex max-w-7xl flex-col gap-10">
    <!-- Título -->
    <span
      class="w-fit border border-[#59C2FF]/20 bg-[#59C2FF]/5 px-4 py-2 text-sm font-bold uppercase tracking-widest text-[#59C2FF]"
    >
      Experiencia
    </span>

    <!-- Descripción -->
    <p class="text-base leading-6 text-stone-300">
      Experiencia participando en proyectos frontend y fullstack enfocados en
      interfaces modernas, e-commerce y soluciones digitales responsivas.
    </p>

    <!-- Card -->
    <div
      class="flex flex-col gap-8 rounded-sm border border-blue-400/30 bg-stone-900 p-5 backdrop-blur-[6px]"
    >
      <!-- Header -->
      <header
        class="flex items-center justify-between border-b border-stone-700/20 pb-4"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-blue-400">
          expe_desarrollada.LOG
        </span>

        <span class="text-sm text-stone-300 opacity-50"> V: 1.1 </span>
      </header>

      <!-- Timeline -->
      <div class="flex flex-col gap-12">
        {
          experience.map((data) => (
            <article class="relative flex flex-col gap-5 border-l border-blue-400/30 pl-8">
              <span class="absolute -left-1.25 top-1 h-2 w-2 rounded-full bg-blue-400 shadow-[0_0_8px_rgba(89,194,255,1)]" />
              <div class="flex flex-wrap items-start justify-between gap-4">
                <h3 class="text-xl font-bold text-stone-200">{data.title}</h3>

                <span class="text-xs text-emerald-400">{data.date}</span>
              </div>
              <p class="text-xs uppercase text-stone-300">{data.company}</p>
              <p class="text-base leading-6 text-stone-300">
                {data.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {data.technologies.map((tech: string) => (
                  <span class="border border-blue-400/30 px-2 py-1 text-[10px] text-blue-400">
                    {tech}
                  </span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
