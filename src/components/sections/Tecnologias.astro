---
import { technologies } from "../../data/tech.ts";
---

<section
  id="technologies"
  class="flex min-h-svh items-center px-6 py-16 lg:px-16 border-b border-white/10"
>
  <div class="mx-auto w-full max-w-7xl">
    <!-- Título -->
    <div class="mb-10">
      <span
        class="w-fit border border-[#59C2FF]/20 bg-[#59C2FF]/5 px-4 py-2 text-sm font-bold uppercase tracking-widest text-[#59C2FF]"
      >
        Tecnologías
      </span>
    </div>

    {
      technologies.map(
        (group: { title: string; techs: { name: string; icon: string }[] }) => (
          <div class="mb-14 last:mb-0">
            <h3 class="mb-4 text-xs font-bold uppercase tracking-[0.15em] text-[#47AFAA]">
              {group.title}
            </h3>

            <div
              class="grid
            grid-cols-2
            sm:grid-cols-3
            md:grid-cols-4
            lg:grid-cols-5
            xl:grid-cols-6
            gap-4 "
            >
              {group.techs.map((tech) => (
                <article class="group flex aspect-square flex-col items-center justify-center gap-4 border border-[#F5F5DC]/15 bg-[#1C1B1B] transition-all duration-300 hover:border-[#59C2FF] hover:bg-[#59C2FF]/8 hover:-translate-y-1 text-stone-300 hover:text-[#59C2FF] font-normal hover:font-bold ">
                  <div class="flex h-12 w-12 items-center justify-center sm:h-14 sm:w-14">
                    <img
                      src={tech.icon}
                      alt={tech.name}
                      class="max-h-full max-w-full object-contain transition duration-300 group-hover:scale-115"
                    />
                  </div>
                  <span class="text-sm tracking-wide">{tech.name}</span>
                </article>
              ))}
            </div>
          </div>
        ),
      )
    }
  </div>
</section>
