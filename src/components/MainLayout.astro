---
import "../../styles/global.css";
import logo from "../../public/logo.png";
import Footer from "../components/layouts/footer.astro";
import Navbar from "../components/layouts/navbar.astro";
import Hero from "../components/sections/Hero.astro";
import Experiencia from "../components/sections/Experiencia.astro";
import Tecnologias from "../components/sections/Tecnologias.astro";
import Proyectos from "../components/sections/Proyectos.astro";
import Laboratorio from "../components/sections/Lab.astro";
import Contactate from "../components/sections/Contactate.astro";
import AlertPage from "../components/layouts/alertPage.astro";
import PopupCv from "../components/layouts/popUpCv.astro";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mi Portafolio</title>

    <!-- Icono -->
    <link rel="icon" type="image/x-icon" href={logo.src} />

    <!-- FontAwesome -->
    <script
      src="https://kit.fontawesome.com/c75f29b3f2.js"
      crossorigin="anonymous"></script>
  </head>

  <body class="bg-[#0E0E0E] text-white">
    <AlertPage />

    <div
      class="min-h-screen lg:grid lg:grid-cols-[16rem_1fr] 2xl:grid-cols-[18rem_1fr]"
    >
      <Navbar />

      <!-- Contenido -->
      <div class="flex min-h-screen min-w-0 flex-col">
        <main class="flex-1">
          <slot />
        </main>
        <Hero />
        <PopupCv />
        <Tecnologias />
        <Proyectos />
        <Experiencia />
        <Laboratorio />
        <Contactate />
        <Footer />
      </div>
    </div>
  </body>
</html>
