---
import avatar from "../../assets/imagenes/navMyavatar.png";
import avatarColor from "../../assets/imagenes/myavatar.png";

import {
  UserRound,
  Cpu,
  Folder,
  Briefcase,
  FlaskConical,
  Mail,
} from "@lucide/astro";

const links = [
  {
    name: "Acerca de mí",
    href: "#about",
    icon: UserRound,
  },
  {
    name: "Tecnologías",
    href: "#technologies",
    icon: Cpu,
  },
  {
    name: "Proyectos",
    href: "#projects",
    icon: Folder,
  },
  {
    name: "Experiencia",
    href: "#experience",
    icon: Briefcase,
  },
  /* {
    name: "Laboratorio",
    href: "#lab",
    icon: FlaskConical,
  },
  */
  {
    name: "Contacto",
    href: "#contact",
    icon: Mail,
  },
];
---

<!-- Responsive Menu button -->
<button
  id="menuBtn"
  class="fixed left-4 top-4 z-50 flex h-11 w-11 items-center justify-center border border-white/10 bg-[#0E0E0E] text-[#C8C8B0] lg:hidden"
  aria-label="Abrir menú"
>
  <i class="fa-solid fa-bars text-xl"></i>
</button>

<!-- Overlay oscuro -->
<div
  id="menuOverlay"
  class="fixed inset-0 z-30 hidden bg-black/60 backdrop-blur-sm lg:hidden"
>
</div>

<!-- Nav - Aside -->
<aside
  class="sticky left-0 top-0 flex justify-center h-screen w-64 flex-col border-r border-white/10 bg-[#0E0E0E] backdrop-blur-md"
>
  <!-- Perfil -->
  <div class="space-y-4 p-6">
    <div
      class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-xl border border-[#59C2FF]/30 bg-stone-900"
    >
      <img
        src={avatar.src}
        alt="Richard Aaron"
        class="h-full w-full object-cover"
      />
    </div>

    <div>
      <h1
        class="text-xs font-bold uppercase leading-5 tracking-[0.15em] text-[#59C2FF]"
      >
        Richard Aaron Ponce Villarroel
      </h1>

      <p class="mt-2 text-xs text-[#D9D9D9]">FullStack Junior</p>
    </div>
  </div>

  <!-- Navegación -->
  <nav class="border-y border-white/10 py-10">
    <ul>
      {
        links.map((link) => {
          const Icon = link.icon;

          return (
            <li>
              <a
                href={link.href}
                data-nav-link
                class="group flex items-center gap-3 px-6 py-3 text-xs font-bold uppercase tracking-[0.15em] text-[#BBCCB0] transition-all duration-300 hover:text-[#59C2FF] hover:ml-1"
              >
                <Icon
                  size={16}
                  class="text-current transition-colors duration-300 group-hover:text-[#59C2FF]"
                />

                {link.name}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <!-- Parte inferior -->
  <footer class="space-y-6 p-8">
    <a
      href="/docs/CV_RichardAaronPonceVillarroel.docx"
      download="CV_RichardAaronPonceVillarroel.docx"
      class="group relative flex h-12 items-center justify-center overflow-hidden border border-[#59C2FF] text-xs uppercase tracking-[0.2em] text-[#59C2FF] transition-colors duration-500 ease-in-out hover:text-[#201F1F]"
    >
      <span class="relative z-10">Descargar CV</span>

      <span
        class="absolute inset-y-0 right-0 w-0 bg-[#59C2FF] transition-all duration-500 ease-in-out group-hover:left-0 group-hover:w-full"
      ></span>
    </a>

    <div class="flex items-center gap-3">
      <img
        src={avatarColor.src}
        alt="Avatar"
        class="h-10 w-10 rounded-full object-cover"
      />

      <div class="text-[11px] uppercase tracking-wider leading-5">
        <p class="text-[#59C2FF]">Status: Activo</p>
        <p class="text-[#C8C8B0]">Level: Junior</p>
      </div>
    </div>

    <div class="flex items-center justify-between text-3xl">
      <a
        href="https://github.com/MrAaronPv"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#fffff] transition duration-200 ease-in hover:scale-120"
      >
        <i class="fa-brands fa-github"></i>
      </a>

      <a
        href="https://www.linkedin.com/in/aaron-ponce-v-b18705273/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#C8C8B0] transition duration-200 ease-in hover:scale-120 hover:text-[#59C2FF]"
      >
        <i class="fa-brands fa-linkedin-in text-[#0A66C2]"></i>
      </a>

      <a
        href="mailto:aaronponcevi@gmail.com"
        class="transition duration-200 ease-in hover:scale-120 hover:text-[#59C2FF]"
      >
        <i class="fa-solid fa-envelope text-[#EA4335]"></i>
      </a>
    </div>
  </footer>
</aside>

<script>
  const links = document.querySelectorAll("[data-nav-link]");
  const sections = document.querySelectorAll("section[id]");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        links.forEach((link) => link.classList.remove("nav-active"));

        document
          .querySelector(`[href="#${entry.target.id}"]`)
          ?.classList.add("nav-active");
      });
    },
    {
      rootMargin: "-30% 0px -60% 0px",
      threshold: 0,
    },
  );

  sections.forEach((section) => observer.observe(section));
</script>
