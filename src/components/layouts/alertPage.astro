<script>
  document.addEventListener("DOMContentLoaded", () => {
    const alertContainer = document.createElement("div");

    alertContainer.className =
      "fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4";

    alertContainer.innerHTML = `
      <div
        class="relative w-full max-w-2xl mx-auto overflow-hidden border border-blue-400/30 bg-stone-900/80 px-6 py-8 sm:px-10 sm:py-10 backdrop-blur-md"
      >
        <!-- Línea superior -->
        <div
          class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-400/50 to-transparent"
        ></div>

        <!-- Icono -->
        <div class="relative mx-auto flex h-16 w-16 items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#FFF159" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-construction-icon lucide-construction"><rect x="2" y="6" width="20" height="8" rx="1"/><path d="M17 14v7"/><path d="M7 14v7"/><path d="M17 3v3"/><path d="M7 3v3"/><path d="M10 14 2.3 6.3"/><path d="m14 6 7.7 7.7"/><path d="m8 6 8 8"/></svg>
        </div>

        <!-- Título -->
        <h2
          class="text-center font-['JetBrains_Mono'] text-lg uppercase tracking-[0.2em] text-blue-400 sm:text-xl"
        >
          Web en desarrollo
        </h2>

        <!-- Contenido -->
        <div class="mx-auto mt-4 max-w-xl space-y-4 text-center font-['JetBrains_Mono']">
          <p class="text-sm leading-6 text-stone-300 sm:text-base">
            Esta web aún se encuentra en desarrollo. Algunas secciones o contenidos
            podrían estar desactualizados o presentar pequeños errores.
          </p>

          <p class="text-sm leading-6 text-stone-300 sm:text-base">
            Estamos trabajando para mejorarla y actualizarla próximamente.
          </p>

          <p class="text-xs leading-6 text-blue-400/80 sm:text-sm">
            ¡Gracias por visitar la web y disfrutar del contenido! <i class="fa-solid fa-rocket"></i>
          </p>
        </div>

        <!-- Estado -->
        <div
          class="mt-6 flex flex-wrap items-center justify-center gap-3 font-['JetBrains_Mono'] text-xs text-stone-300/40"
        >
          <span class="text-base text-blue-400">&gt;</span>
          <span>SYSTEM_STATUS:</span>
          <span>BUILDING...</span>
        </div>

        <!-- Botón -->
        <button
          id="close-alert"
          class="mx-auto mt-6 block border border-blue-400/30 px-5 py-2 font-['JetBrains_Mono'] text-xs uppercase tracking-wider text-blue-400 transition hover:bg-blue-400/10"
        >
          Continuar
        </button>
      </div>
    `;

    document.body.appendChild(alertContainer);

    document.getElementById("close-alert")?.addEventListener("click", () => {
      alertContainer.remove();
    });
  });
</script>
